      <End Role="Attendance" EntitySet="Attendances" />
    </AssociationSet>
    <AssociationSet Name="FK_Employees_Shift" Association="Self.FK_Employees_Shift">
      <End Role="Shifts" EntitySet="Shifts" />
      <End Role="Employees" EntitySet="Employees" />
    </AssociationSet>
  </EntityContainer>
</Schema>