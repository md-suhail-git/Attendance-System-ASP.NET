<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Dash.Master.cs" Inherits="Attendance.Dash" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Attendance Dashboard</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(to right, #00c6ff, #0072ff);
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
        }

        .layout {
            display: flex;
            height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 240px;
            background: #0f3d91;
            color: white;
            padding: 20px 0;
            transition: all 0.3s ease;
            overflow-y: auto;
        }

            .sidebar h2 {
                text-align: center;
                margin-bottom: 30px;
                padding: 0 20px;
                font-size: 1.5em;
                font-weight: 600;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                color: white;
                padding: 12px 20px;
                text-decoration: none;
                margin-bottom: 5px;
                transition: all 0.3s ease;
                border-left: 5px solid transparent;
            }

                .sidebar a i {
                    margin-right: 12px;
                    font-size: 18px;
                    width: 25px;
                    text-align: center;
                }

                /* Hover and Active State */
                .sidebar a:hover {
                    background: #0072ff;
                    border-left-color: #f7f7f7;
                }

                /* ---------------------------------------------------- */
                /* ACTIVE LINK STYLING WITH SHADOW (Final Requirement) */
                /* ---------------------------------------------------- */
                .sidebar a.active {
                    background: #0072ff;
                    border-left-color: #FFEB3B;
                    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
                    color: #fff;
                }

            /* Collapsed sidebar */
            .sidebar.collapsed {
                width: 70px;
                padding: 20px 0;
            }

                .sidebar.collapsed h2 {
                    display: none;
                }

                .sidebar.collapsed a {
                    padding: 12px 0;
                    justify-content: center;
                }

                    .sidebar.collapsed a i {
                        margin-right: 0;
                        width: auto;
                    }

                    .sidebar.collapsed a span {
                        display: none;
                    }

        /* Main content */
        .main {
            flex: 1;
            padding: 0;
            overflow-y: auto;
            width: calc(100% - 240px);
            transition: all 0.3s ease;
            background-color: #f7f7f7;
        }

            .main.full {
                width: calc(100% - 70px);
            }

        /* Top header */
        .header {
            background: white;
            padding: 15px 25px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            margin-bottom: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 10;
        }

            .header h3 {
                margin: 0;
                color: #333;
                font-weight: 500;
            }

        /* Toggle button */
        .toggle-btn {
            font-size: 26px;
            cursor: pointer;
            color: #0f3d91;
            margin-right: 15px;
            line-height: 1;
        }

        /* Content placeholder style (where your pages load) */
        .content-area {
            padding: 20px;
        }
    </style>
    <script type="text/javascript">
        function preventNavigation() {
            window.history.pushState(null, null, window.location.href);
            window.onpopstate = function () {
                window.history.pushState(null, null, window.location.href);
            };
        }
        window.onload = preventNavigation;
    </script>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <form runat="server">
        <div class="layout">

            <div class="sidebar" id="sidebar">
                <h2>DashAdmin</h2>
                <a href="AdminDashboard.aspx"><i class="fa fa-home"></i><span>Dashboard</span></a>
                <a href="NewReport.aspx"><i class="fa fa-calendar-day"></i><span>Today Report</span></a>
                <a href="EmployeeDashboard.aspx"><i class="fa fa-users"></i><span>Employee Report</span></a>
                <a href="EmployeeAttendance.aspx"><i class="fa fa-user-plus"></i><span>Employee Attendance</span></a>
                <a href="ManualAttendance.aspx"><i class="fa-solid fa-toolbox"></i><span>Manual Attendance</span></a>
               <%-- <a href="ShiftAttendance.aspx"><i class="fa-solid fa-shirt"></i><span>Shift Attendance</span></a>--%>
                <a href="Login.aspx"><i class="fa fa-sign-out-alt"></i><span>Logout</span></a>
            </div>

            <div class="main" id="mainContent">

                <div class="header">
                    <span class="toggle-btn" onclick="toggleSidebar()">☰</span>
                    <h3>Employee Attendance System</h3>
                    <asp:Label ID="lblUser" runat="server"></asp:Label>
                </div>

                <div class="content-area">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>

            </div>

        </div>
    </form>

    <script>
        // Sidebar Toggle
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('collapsed');
            document.getElementById('mainContent').classList.toggle('full');
        }

        // Active Link Highlight - FIXED ✅
        document.addEventListener("DOMContentLoaded", function () {

            const links = document.querySelectorAll(".sidebar a");

            // Get page name only (no query string)
            let currentPage = window.location.pathname.split("/").pop();
            currentPage = currentPage ? currentPage.toLowerCase() : "admindashboard.aspx"; // default page

            links.forEach(link => {

                let linkPage = link.getAttribute("href").toLowerCase();

                // remove active class from all first
                link.classList.remove("active");

                // check for match
                if (currentPage === linkPage) {
                    link.classList.add("active");
                }

            });
        });
    </script>

</body>
</html>
